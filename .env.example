# Canonical project environment template. Copy to the ignored repository-root .env.
# Every value below is fictional. Replace all marked values before production.

# PostgreSQL Compose initialization (confidential; local example values only).
POSTGRES_DB=sensoria
POSTGRES_USER=sensoria
POSTGRES_PASSWORD=change-me-before-production

# API runtime (required; confidential). Compose overrides host in DATABASE_URL to db.
DATABASE_URL=postgresql+asyncpg://sensoria:change-me-before-production@localhost:5432/sensoria
ENVIRONMENT=development
SECRET_KEY=replace-with-a-local-random-value

# Test-only; confidential fake credential; use a separate empty PostgreSQL 16 database.
TEST_DATABASE_URL=postgresql+asyncpg://sensoria:change-me-before-production@localhost:5432/sensoria_test

# Next.js server runtime and browser public address. NEXT_PUBLIC_* is public and build-time.
API_URL=http://localhost:8000
NEXT_PUBLIC_API_URL=http://localhost/api
# Public canonical origin used by product/category metadata, JSON-LD, robots and sitemap.
# Required by the web server; production must use the real HTTPS origin.
SITE_URL=http://localhost
# Optional public brand Open Graph image URL/path; set to a real asset before production.
SITE_OG_IMAGE=

# Krótki cache publicznego katalogu (0 wyłącza; zakres 0–300 sekund).
CATALOG_CACHE_TTL_SECONDS=30
# Guest-cart cleanup interval (seconds) and maximum guest baskets removed per worker run.
CART_CLEANUP_INTERVAL_SECONDS=3600
CART_CLEANUP_BATCH_SIZE=500

# Public sample access limits. PostgreSQL-backed and shared across API workers.
SAMPLE_STORAGE_ROOT=/app/uploads/samples
SAMPLE_OPEN_LIMIT=12
SAMPLE_OPEN_WINDOW_SECONDS=60
SAMPLE_STREAM_LIMIT=120
SAMPLE_STREAM_WINDOW_SECONDS=60
SAMPLE_SESSION_TTL_SECONDS=1800
SAMPLE_SESSION_REQUEST_LIMIT=24
# Compose's internal proxy network only; update when the Compose subnet changes.
TRUSTED_PROXY_CIDRS=172.16.0.0/12
LOGIN_LINK_EMAIL_LIMIT=4
LOGIN_LINK_IP_LIMIT=20
LOGIN_LINK_WINDOW_SECONDS=3600
LOGIN_LINK_COOLDOWN_SECONDS=900
LOGIN_LINK_INVALID_LIMIT=20

# Backend timeout for InPost Points API requests (never sent to the browser).
INPOST_POINTS_TIMEOUT_SECONDS=5

# Caddy domain and host port mappings (change DOMAIN for public production TLS).
DOMAIN=localhost
COMPOSE_PROJECT_NAME=sensoria
HTTP_PORT=80
HTTPS_PORT=443

# Development-only direct host access to services; not published in production.
API_PORT=8000
WEB_PORT=3000
DB_PORT=5432
CADDY_HTTP_PORT=80

# Test harness override only. Normally unset; tests set it only for isolated config cases.
# SENSORIA_ENV_FILE=
